# ==============================================================================
# CP2K Input | Si Bulk Static Polarizability (Linear Response)
# Sources: CP2K manual FORCE_EVAL/PROPERTIES/LINRES/POLAR
#          https://manual.cp2k.org/trunk/CP2K_INPUT/FORCE_EVAL/PROPERTIES/LINRES/POLAR.html
#          CP2K manual methods/dft/k-points (OT/LINRES vs k-points compatibility)
#          https://manual.cp2k.org/trunk/methods/dft/k-points.html
#
# GAMMA-ONLY WORKFLOW (Route A). The two CP2K optics/response routes are
# mutually exclusive:
#   Route A (this file): Gamma-only + &OT + &LINRES/&POLAR (DFPT).
#     For a bulk crystal, converge the SUPERCELL size instead of a k-mesh.
#   Route B: k-point SCF with &DIAGONALIZATION (NOT &OT) and NO &LINRES —
#     LINRES/DFPT does not support k-points; &OT does not support k-points.
#     k-point optical spectra then need a different method (outside this file).
# ==============================================================================

&GLOBAL
  PROJECT     Si_optics
  RUN_TYPE    LINEAR_RESPONSE
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      600
      REL_CUTOFF  60
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL

      # Uncomment for GGA if you see "XC_DERIV method not implemented":
      # &XC_GRID
      #   XC_DERIV NN10_SMOOTH
      # &END XC_GRID
    &END XC

    &SCF
      SCF_GUESS   RESTART
      EPS_SCF     1.0E-7
      MAX_SCF     300

      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_KINETIC
      &END OT

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING
    &END SCF

    &POISSON
      PERIODIC XYZ
    &END POISSON

    # NO &KPOINTS section here: this is a Gamma-only workflow.
    # &OT (above) does not support k-points, and &LINRES/DFPT response
    # (below) does not support k-points either. For bulk Si, converge the
    # supercell size (e.g. 2x2x2 of the conventional cell) instead.
    # NOTE: a Gamma-only conventional Si cell under-samples the BZ — treat
    # the numbers as a workflow demonstration, not converged physics.

  &END DFT

  &PROPERTIES
    &LINRES
      EPS        1.0E-10
      MAX_ITER   100
      PRECONDITIONER FULL_SINGLE_INVERSE

      &POLAR
        DO_RAMAN T
      &END POLAR
    &END LINRES
  &END PROPERTIES

  &SUBSYS
    &CELL
      ABC     5.431 5.431 5.431       # Si conventional cubic cell (Angstrom)
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./Si_bulk.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

&END FORCE_EVAL

# Post-processing: read static polarizability tensor from output; derive dielectric
# constant from alpha and cell volume.
