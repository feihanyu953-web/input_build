# ==============================================================================
# CP2K Input | Si Bulk Electron Localization Function
# Sources: CP2K manual FORCE_EVAL/DFT/PRINT/ELF_CUBE
#          https://manual.cp2k.org/trunk/CP2K_INPUT/FORCE_EVAL/DFT/PRINT/ELF_CUBE.html
# ==============================================================================

&GLOBAL
  PROJECT     Si_elf
  RUN_TYPE    ENERGY
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      600
      REL_CUTOFF  60
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   RESTART
      EPS_SCF     1.0E-7
      MAX_SCF     300

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING
    &END SCF

    &POISSON
      PERIODIC XYZ
    &END POISSON

    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
    &END KPOINTS

    &PRINT
      &ELF_CUBE ON
        STRIDE 2 2 2
      &END ELF_CUBE
    &END PRINT

  &END DFT

  &SUBSYS
    &CELL
      ABC     5.431 5.431 5.431
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./Si_bulk.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

&END FORCE_EVAL

# Post-processing: visualize ELF cube with VMD / VESTA / ovito.
# ELF = 1.0: localized; 0.5: electron-gas-like; 0.0: delocalized/vacuum.
