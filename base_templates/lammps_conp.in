# ==============================================================================
# LAMMPS Input Script | Constant-Potential Electrode (fix electrode/conp)
# Generated by input-build
# ==============================================================================
# PREREQUISITE: LAMMPS must be built with the ELECTRODE package
# (fix electrode/conp, Ahrens-Iwers et al.). The kspace style MUST be one of
# pppm/electrode, pppm/electrode/intel or ewald/electrode — plain pppm crashes.
# Reference: docs.lammps.org/fix_electrode.html
# ==============================================================================

# ==============================================================================
# 1. SIMULATION ENVIRONMENT
# ==============================================================================
units           real                # kcal/mol, A, fs, K, bar (electrochemistry convention)
atom_style      full                # Charges + bonds required (electrolyte)
boundary        p p p               # Fully periodic: use with `ffield yes` (finite-field mode)
newton          on

# ==============================================================================
# 2. SYSTEM SETUP
# ==============================================================================
read_data       system.data         # >>> USER: your electrode + electrolyte data file <<<

# --- Electrode groups (REQUIRED; adapt type/molecule selection to your data file) ---
# >>> USER: define the two electrode groups <<<
# group         bot type 6                          # bottom electrode atoms
# group         top type 7                          # top electrode atoms
# group         electrolyte subtract all bot top    # everything else

# ==============================================================================
# 3. FORCE FIELD
# ==============================================================================
# >>> USER: insert pair_style/pair_coeff here (must include coul/long) <<<
#
# pair_style      lj/cut/coul/long 12.0
# pair_coeff      * * ...

# --- Long-range Coulomb: /electrode variant is MANDATORY for fix electrode/* ---
kspace_style    pppm/electrode 1.0e-7
# kspace_modify amat onestep        # onestep (default) | twostep (faster for large electrodes)

# ==============================================================================
# 4. CONSTANT-POTENTIAL FIXES
# ==============================================================================
# fix electrode/conp <pot> <eta>: pot in V, eta = reciprocal width of the Gaussian
# electrode charge distribution (1/A; ~1.8-2.0 for C/Au electrodes).
# `couple` links the counter-electrode; `symm on` enforces Q_top = -Q_bot;
# `ffield yes` = finite-field mode (required with boundary p p p).

# >>> USER: set potentials (V) and uncomment after defining groups <<<
# variable        v equal ramp(0.0, 2.0)            # optional potential ramp (V)
# fix             conp bot electrode/conp -1.0 1.805 couple top 1.0 symm on ffield yes etypes on
# fix_modify      conp energy yes

# --- Alternatives ---
# Constant charge instead of constant potential:
# fix             conq bot electrode/conq -0.5 1.805 couple top 0.5 symm on ffield yes
# Thermo-potentiostat (Deissenbeck; exactly two electrodes):
# fix             tp bot electrode/thermo -1.0 1.805 couple top 1.0 temp 300.0 0.5 symm on ffield yes

# ==============================================================================
# 5. DYNAMICS
# ==============================================================================
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        1.0                 # fs (units real); use fix shake for rigid water

# fix             shake water shake 1.0e-4 20 0 b 1 a 1   # >>> USER: bond/angle IDs <<<
velocity        all create 300.0 12345 dist gaussian
fix             nvt electrolyte nvt temp 300.0 300.0 100.0

# --- Electrode charge monitoring (essential output for CONP) ---
# variable        q atom q
# compute         qbot bot reduce sum v_q
# compute         qtop top reduce sum v_q

thermo          100
thermo_style    custom step temp pe etotal # c_qbot c_qtop

dump            1 all custom 1000 traj.lammpstrj id type x y z q   # q: track charges!
dump_modify     1 sort id

restart         50000 restart1.restart restart2.restart

run             100000              # 100 ps at 1 fs

# ==============================================================================
# END OF INPUT
# ==============================================================================
# Notes:
# - With ffield yes the cell stays fully periodic; do NOT add kspace_modify slab.
#   (Non-periodic-z alternative: boundary p p f + kspace_modify slab 3.0 + drop
#   `ffield yes` — see docs.lammps.org/fix_electrode.html)
# - Equilibrate at 0 V first, then ramp to the target potential.
# - Check convergence of electrode charges before production statistics.
# ==============================================================================
