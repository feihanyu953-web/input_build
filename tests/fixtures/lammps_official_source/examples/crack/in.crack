# synthetic fixture mimicking official LAMMPS crack example layout
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 16 0 16 0 16
create_box      1 box
create_atoms    1 box
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
velocity        all create 1.0 87287
fix             1 all nve
thermo          100
run             1000
