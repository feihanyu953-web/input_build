# ==============================================================================
# CP2K Input | Work Function via Hartree Potential (planar-averaged)
# Source: CP2K manual FORCE_EVAL/DFT/PRINT/V_HARTREE_CUBE (2026.1-safe route)
#         CP2K manual FORCE_EVAL/DFT/PLANAR_AVERAGED_V_HARTREE (2026.2-dev+)
# Version gate (runtime-verified): &PLANAR_AVERAGED_V_HARTREE was added in the
# 2026.2-dev trunk; CP2K 2026.1 aborts with
# "unknown subsection PLANAR_AVERAGED_V_HARTREE of section DFT". This template
# therefore defaults to &V_HARTREE_CUBE (cube file + external planar average).
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
&GLOBAL
  PROJECT     cp2k_workfunction       # Job name (prefix for output files)
  RUN_TYPE    ENERGY                  # Static SCF; planar average is printed
  PRINT_LEVEL LOW
&END GLOBAL

# ------------------------------------------------------------------------------
# II. FORCE EVALUATION
# ------------------------------------------------------------------------------
&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      600                 # Higher cutoff for smooth potential
      REL_CUTOFF  60
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   RESTART             # Read from prior converged SCF (faster)
      EPS_SCF     1.0E-7              # Tight convergence for accurate potential
      MAX_SCF     300

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING

      # For metallic systems, enable smearing:
      # &SMEAR
      #   METHOD FERMI_DIRAC
      #   ELECTRONIC_TEMPERATURE [K] 300
      # &END SMEAR
      # ADDED_MOS 100                 # NOTE: ADDED_MOS is a keyword of &SCF,
                                      # not a section (no '&'). CP2K manual:
                                      # FORCE_EVAL/DFT/SCF.
    &END SCF

    # Periodicity is an ATOMIC config block: &CELL PERIODIC, &POISSON PERIODIC
    # and POISSON_SOLVER must be chosen together (see references/cp2k.md).
    # Default below: 3D-periodic approximation of the slab (vacuum along z,
    # CELL PERIODIC XYZ + default PERIODIC solver) — valid, but images
    # interact across the vacuum gap.
    &POISSON
      PERIODIC XYZ
      # For a true 2D slab (decoupled images), switch to:
      #   CELL PERIODIC XYZ (unchanged) + this block:
      # POISSON_SOLVER ANALYTIC         # ANALYTIC supports 0D/2D boundary conditions
      # PERIODIC XY
    &END POISSON

    # --- Optional: surface dipole correction (FORCE_EVAL/DFT level) ---
    # Enable for ASYMMETRIC or POLAR slabs: single-side adsorption,
    # different top/bottom terminations, or polar surfaces. A net dipole makes
    # the electrostatic potential ramp across the vacuum, so the planar-averaged
    # plateau gets a slope and the extracted work function is biased. The
    # correction adds a compensating sawtooth field in the vacuum region.
    # Do NOT enable for symmetric slabs (no net dipole; it only adds noise).
    # Source: CP2K manual FORCE_EVAL/DFT (SURFACE_DIPOLE_CORRECTION, SURF_DIP_DIR)
    # SURFACE_DIPOLE_CORRECTION .TRUE.
    # SURF_DIP_DIR Z                      # Surface normal direction (X/Y/Z)

    # --- Built-in planar-averaged Hartree potential (CP2K >= 2026.2 ONLY) ---
    # &PLANAR_AVERAGED_V_HARTREE is a 2026.2-dev trunk addition; CP2K 2026.1
    # aborts on it ("unknown subsection ... of section DFT", runtime-verified).
    # On 2026.1 use &V_HARTREE_CUBE below instead. On >= 2026.2 you may
    # comment out &V_HARTREE_CUBE and uncomment:
    # Source: CP2K manual FORCE_EVAL/DFT/PLANAR_AVERAGED_V_HARTREE
    # &PLANAR_AVERAGED_V_HARTREE
    #   SECTION_PARAMETERS ON
    #   PARALLEL_PLANE XY             # Slab surface is in xy-plane; normal is z
    # &END PLANAR_AVERAGED_V_HARTREE

    &PRINT
      # 2026.1-safe route: write the Hartree potential cube, then plane-average
      # externally over the xy planes (e.g. numpy / cp2kdata / macroavg) to get
      # the V(z) profile; the vacuum plateau gives V_vac.
      &V_HARTREE_CUBE ON
      &END V_HARTREE_CUBE
      &E_DENSITY_CUBE OFF
      &END E_DENSITY_CUBE
    &END PRINT

  &END DFT

  &SUBSYS
    &CELL
      ABC     10.0 10.0 30.0          # Example: Au slab with vacuum along z
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    # >>> USER: add one &KIND block per element type <<<
    &KIND Au
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./coord.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

&END FORCE_EVAL

# ==============================================================================
# END OF INPUT
# ==============================================================================
# Post-processing:
# 1. CP2K 2026.1 (this template): read the *-v_hartree-1_0.cube file and
#    average over the xy planes to get V(z) in Hartree (e.g. with numpy,
#    cp2kdata, or the CPACR/macroavg scripts).
#    CP2K >= 2026.2 (alternative): &PLANAR_AVERAGED_V_HARTREE writes the
#    planar-averaged Hartree potential along z directly.
# 2. Identify the flat plateau in the vacuum region (V_vac).
# 3. Read the Fermi energy from the CP2K output (E_Fermi).
# 4. Work function: Phi = (V_vac - E_Fermi) * 27.211386 eV
#
# Note: the cube route (and PLANAR_AVERAGED_V_HARTREE) is designed for
#       symmetric slabs. For asymmetric/polar slabs, enable
#       SURFACE_DIPOLE_CORRECTION + SURF_DIP_DIR (block provided above)
#       before extracting V_vac.
# ==============================================================================
