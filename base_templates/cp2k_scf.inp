# ==============================================================================
# CP2K Input | Static SCF (Single-Point Energy + Forces)
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
&GLOBAL
  PROJECT     cp2k_scf                # Job name (prefix for output files)
  RUN_TYPE    ENERGY_FORCE            # Single-point energy and forces
  PRINT_LEVEL LOW
&END GLOBAL

# ------------------------------------------------------------------------------
# II. FORCE EVALUATION
# ------------------------------------------------------------------------------
&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      400                 # Ry; increase for accuracy (e.g., 600 Ry for tight SCF)
      REL_CUTOFF  50
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   ATOMIC              # Start from scratch (or RESTART if continuing)
      EPS_SCF     1.0E-7              # Tight SCF convergence for accurate forces
                                      # VASP equivalent: EDIFF = 1E-6 to 1E-7
      MAX_SCF     300

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING

      # For metallic systems, enable smearing:
      # &SMEAR
      #   METHOD FERMI_DIRAC
      #   ELECTRONIC_TEMPERATURE [K] 300
      # &END SMEAR
      # Robustness note (2026.1 runtime-verified): enable SMEARING even for
      # semiconductors/insulators when running Gamma-only small cells or with
      # large ADDED_MOS — a 2-atom Si cell without smearing oscillated for the
      # full 300 SCF steps; with FERMI_DIRAC 300 K it converged in 12-23 steps.
      # ADDED_MOS 10                  # NOTE: ADDED_MOS is a keyword of &SCF,
                                      # not a section (no '&'). CP2K manual:
                                      # FORCE_EVAL/DFT/SCF.
    &END SCF

    &POISSON
      PERIODIC XYZ
    &END POISSON

    &PRINT
      &E_DENSITY_CUBE OFF             # Set ON to write electron density cube (large files)
      &END E_DENSITY_CUBE
    &END PRINT

  &END DFT

  &SUBSYS
    &CELL
      ABC     10.0 10.0 10.0
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    # >>> USER: add one &KIND block per element type <<<
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./coord.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

  # --- Output control ---
  # &FORCES belongs to FORCE_EVAL/PRINT — under DFT/PRINT CP2K aborts with
  # "unknown subsection FORCES of section PRINT" (2026.1 runtime-verified).
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT

&END FORCE_EVAL

# ==============================================================================
# END OF INPUT
# ==============================================================================
# CP2K vs VASP quick reference:
# - CUTOFF (Ry) is NOT convertible to ENCUT (eV): CUTOFF controls the auxiliary
#   real-space grid for density/potential (orbitals use Gaussian basis).
#   Converge CUTOFF and REL_CUTOFF independently per system (400-600 Ry typical).
# - EPS_SCF     ≈ EDIFF
# - MAX_SCF     ≈ NELM
# - BROYDEN_MIXING ≈ VASP default mixing (IMIX=4)
# - ALPHA       ≈ AMIX
# - SMEAR/FERMI_DIRAC ≈ ISMEAR=-1 (VASP Fermi smearing)
# - ELECTRONIC_TEMPERATURE [K] ≈ SIGMA × 11604.5 (K/eV)
# ==============================================================================
