# ==============================================================================
# LAMMPS Input Script | Multi-Stage MD
# Generated by input-build
# ==============================================================================
# Standard multi-stage protocol (consult references/lammps_best_practices.md):
#   Stage 0: Energy minimization (remove bad contacts)
#   Stage 1: NVT slow heating (ramp from low T to target T, prevent atom explosion)
#   Stage 2: NVT equilibration (stabilize at target T)
#   Stage 3: NPT equilibration (stabilize density, OPTIONAL)
#   Stage 4: NVT/NVE production (data collection)
# ==============================================================================

# ==============================================================================
# 1. SIMULATION ENVIRONMENT
# ==============================================================================
units           metal               # eV, Å, ps, K, bar
atom_style      atomic              # For MLFF/most potentials (use full for bonds)
boundary        p p p               # 3D periodic (slab: use p p f, z = surface normal)
newton          on

# ==============================================================================
# 2. SYSTEM SETUP
# ==============================================================================
read_data       system.data
# NOTE: Element order in data file must match pair_coeff order in Section 3

# ==============================================================================
# 3. FORCE FIELD (User-defined)
# ==============================================================================
# >>> USER: insert pair_style/pair_coeff here (REQUIRED - examples below) <<<
#
# --- EAM ---
# File format determines pair_style AND pair_coeff arity
# (https://docs.lammps.org/pair_eam.html):
#   funcfl single-element (*.eam, e.g. Cu_u3.eam, Al_u3.eam) -> pair_style eam
#     pair_coeff takes exactly 3 args (* * file) with NO element symbol —
#     pair_eam.cpp enforces narg == 3; a 4th arg (element symbol) aborts with
#     "Incorrect args for pair coefficients" (22Jul2025 runtime-verified)
#   setfl alloy (*.eam.alloy, e.g. Al99.eam.alloy)           -> pair_style eam/alloy
#     pair_coeff REQUIRES element symbol(s) after the file
# A mismatched format/style pair aborts with a potential-file parse error.
# pair_style      eam
# pair_coeff      * * Cu_u3.eam
#
# pair_style      eam/alloy
# pair_coeff      * * Al99.eam.alloy Al
#
# --- DeepMD ---
# pair_style      deepmd graph.pb
# pair_coeff      * *
#
# --- MACE ---
# pair_style      mace
# pair_coeff      * * mace.model H O Pt
#
# --- ReaxFF (requires REAXFF package) ---
# NOTE: the legacy REAX-C pair style was removed in LAMMPS 2024+; use reaxff.
# Hard requirements: atom_style charge (or full) for per-atom charge,
# plus fix qeq/reaxff charge equilibration; units real is conventional.
# atom_style      charge
# pair_style      reaxff NULL
# pair_coeff      * * ffield.reax C H O N
# fix             qeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff
#
# --- Classical (LJ/Coulomb) ---
# pair_style      lj/cut/coul/long 10.0
# pair_coeff      1 1 0.15535 3.166
# kspace_style    pppm 1.0e-5

# ==============================================================================
# 4. NEIGHBOR LIST & TIMESTEP
# ==============================================================================
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        0.0005              # 0.5 fs (safe for H; use 0.001 for heavy-only)
# timestep      0.001               # 1.0 fs (no H)
# timestep      0.002               # 2.0 fs (H + SHAKE only)

# ==============================================================================
# 5. STAGE 0: ENERGY MINIMIZATION
# ==============================================================================
# Remove bad contacts before dynamics; always minimize before MD
min_style       cg
minimize        1.0e-4 1.0e-6 1000 10000
#                 etol   ftol   maxiter maxeval

# ==============================================================================
# 6. STAGE 1: NVT SLOW HEATING (prevent atom explosion)
# ==============================================================================
# Start at low temperature and ramp to target. Direct 300 K velocities on an
# un-equilibrated structure can cause atoms to fly out (especially MLFF,
# interfaces, soft potentials). Slow heating gives the system time to relax.
# Adjust ramp_start and run length as needed; 5-10 ps ramp is typical.

velocity        all create 100.0 12345 dist gaussian
#                    ^^^ low T    seed

fix             heat all nvt temp 100.0 300.0 0.05
#                                   ^^^^  ^^^^  Tdamp(ps)
#                                   ramp_start  ramp_target

thermo          100
thermo_style    custom step temp press pe ke etotal vol density cpu

run             10000               # 5 ps ramp from 100 K to 300 K at 0.5 fs
unfix           heat

# ==============================================================================
# 7. STAGE 2: NVT EQUILIBRATION (stabilize at target T)
# ==============================================================================
# Hold at target temperature; verify convergence before production.
# See best-practices.md §5: temp std/mean < 1% over 1000-step window.

fix             equil all nvt temp 300.0 300.0 0.05

run             20000               # 10 ps at target T; extend if not converged
# unfix         equil               # Uncomment before Stage 3

# ==============================================================================
# 8. STAGE 3: NPT EQUILIBRATION (density stabilization, OPTIONAL)
# ==============================================================================
# Only needed when volume/density matters (liquids, interfaces, solutions).
# Skip for fixed-volume solids or slab calculations with no density concern.
# For slab/interface: use x/y only, NEVER iso or z (vacuum compression).
# Pdamp = 0.5 ps (500 fs) is standard; see best-practices.md §3.
#
# Slab (surface normal = z, boundary p p f):
# NEVER barostat the vacuum (non-periodic z) direction, and never use `iso`
# on a slab — it would shrink/expand the vacuum layer.
# Recommended: barostat only the periodic in-plane directions x and y.

# unfix         equil
# fix           equil all npt temp 300.0 300.0 0.05 iso 0.0 0.0 0.5
# -- slab variant (xy only, z fixed) --
# fix           equil all npt temp 300.0 300.0 0.05 x 0.0 0.0 0.5 y 0.0 0.0 0.5

# run           50000               # 25 ps NPT equilibration

# ==============================================================================
# 9. STAGE 4: PRODUCTION (data collection)
# ==============================================================================
# Switch to fresh fix for production (clean statistics)
unfix           equil
fix             prod all nvt temp 300.0 300.0 0.05

# (Optional) Switch to NVE for transport properties (diffusion, viscosity)
# unfix         prod
# fix           prod all nve

# (Optional) Recenter slab to avoid drift
# fix           center all recenter INIT INIT INIT shift all

# --- Trajectory output ---
dump            1 all custom 100 traj.lammpstrj id type x y z
# dump          1 all custom 100 traj.lammpstrj id type xu yu zu vx vy vz fx fy fz
dump_modify     1 sort id

# --- Restart files (for crash recovery / continuation) ---
restart         10000 restart1.restart restart2.restart
# To continue from a restart:
#   read_restart  restart2.restart
#   # Re-declare fixes, dump, etc. (restart restores positions/velocities/box only)

# --- Run production ---
run             200000              # 100 ps at 0.5 fs
# run           2000000             # 1 ns for diffusion/viscosity

# ==============================================================================
# END OF INPUT
# ==============================================================================
# Post-run checks:
# - Temperature stability: last 5000 steps std/mean < 1%
# - Energy drift (NVE): < 1 meV/atom/ps
# - Density (NPT): match experiment ± 2%
# - For continuation: read_restart + re-declare fixes
# Consult references/lammps_best_practices.md for convergence criteria.
# ==============================================================================
