# ==============================================================================
# CP2K Input | Nudged Elastic Band (CI-NEB)
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
&GLOBAL
  PROJECT     cp2k_neb                # Job name (prefix for output files)
  RUN_TYPE    BAND                    # BAND = NEB in CP2K terminology
  PRINT_LEVEL LOW
&END GLOBAL

# ------------------------------------------------------------------------------
# II. FORCE EVALUATION (single replica template; repeated for each image)
# ------------------------------------------------------------------------------
&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      400
      REL_CUTOFF  50
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   RESTART             # Read from prior replica or previous step
      EPS_SCF     1.0E-6
      MAX_SCF     300

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING
    &END SCF

    &POISSON
      PERIODIC XYZ
    &END POISSON

  &END DFT

  &SUBSYS
    &CELL
      ABC     10.0 10.0 10.0
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    # >>> USER: add one &KIND block per element type <<<
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    # REQUIRED even for NEB: &REPLICA coordinates do NOT exempt &SUBSYS from
    # providing a coordinate source — without one CP2K 2026.1 aborts in
    # topology.F with "No atomic coordinates" (runtime-verified). Any
    # consistent geometry works (e.g. the initial state); each &REPLICA below
    # then overrides the coordinates per image.
    &TOPOLOGY
      COORD_FILE_NAME    ./coord.xyz   # NOTE: replace, e.g. with the initial state
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

&END FORCE_EVAL

# ------------------------------------------------------------------------------
# III. NEB / BAND MOTION
# ------------------------------------------------------------------------------
&MOTION
  &BAND
    # --- Parallelization ---
    # Total CPUs = NPROC_REP × NUMBER_OF_REPLICA
    NPROC_REP        4               # CPUs per replica/image
    NUMBER_OF_REPLICA 8              # Total images (includes initial + final)

    # --- NEB algorithm ---
    BAND_TYPE        CI-NEB          # CI-NEB / IT-NEB / B-NEB / D-NEB / SM
    K_SPRING         0.05            # Spring constant (Ha/bohr²)
                                     # Start with 0.05, reduce to 0.02 for precision

    # --- Convergence criteria ---
    &CONVERGENCE_CONTROL
      MAX_FORCE  4.5E-4             # Max force threshold (Hartree/bohr)
      RMS_FORCE  3.0E-4             # RMS force threshold
      MAX_DR     3.0E-3             # Max displacement threshold (bohr)
      RMS_DR     1.5E-3             # RMS displacement threshold (bohr)
    &END CONVERGENCE_CONTROL

    ROTATE_FRAMES    F               # Do not rotate frames
    ALIGN_FRAMES     F               # Do not align frames

    # --- CI-NEB settings ---
    &CI_NEB
      NSTEPS_IT  5                   # Normal NEB steps before climbing image activates
    &END CI_NEB

    # --- Band optimizer ---
    &OPTIMIZE_BAND
      OPT_TYPE   DIIS                # DIIS recommended for NEB
      &DIIS
        NO_LS      T                 # No line search
        MAX_STEPS  1000              # Max optimization steps
        N_DIIS     3                 # Number of DIIS vectors
      &END DIIS
    &END OPTIMIZE_BAND

    # --- Replica definitions (initial and final states required) ---
    # First &REPLICA = initial state
    &REPLICA
      COORD_FILE_NAME  ./init.xyz    # NOTE: replace with initial state
    &END REPLICA

    # Intermediate replicas (optional; CP2K interpolates if omitted)
    # &REPLICA
    #   COORD_FILE_NAME ./replica_02.xyz
    # &END REPLICA

    # Last &REPLICA = final state
    &REPLICA
      COORD_FILE_NAME  ./final.xyz   # NOTE: replace with final state
    &END REPLICA

    # --- Output ---
    &PROGRAM_RUN_INFO
      INITIAL_CONFIGURATION_INFO     # Show distances between replicas
    &END PROGRAM_RUN_INFO

  &END BAND
&END MOTION

# ==============================================================================
# END OF INPUT
# ==============================================================================
# Workflow:
# 1. Optimize initial and final states separately (GEO_OPT)
# 2. Generate interpolated images (e.g., with ASE or pyneb)
# 3. Run NEB calculation
# 4. Check band energies in output; highest energy image ≈ transition state
# 5. (Optional) Optimize the TS candidate with a vibrational frequency calculation
#
# Notes:
# - NPROC_REP × NUMBER_OF_REPLICA must equal total MPI ranks
# - COORD_FILE_NAME expects standard XYZ format (with element symbols)
# - For restart: copy previous replica coordinates as new initial guess
# ==============================================================================
