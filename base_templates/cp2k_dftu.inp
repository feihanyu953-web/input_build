# ==============================================================================
# CP2K Input | DFT+U / Hubbard U Correction
# Sources: CP2K manual FORCE_EVAL/SUBSYS/KIND/DFT_PLUS_U
#          https://manual.cp2k.org/trunk/CP2K_INPUT/FORCE_EVAL/SUBSYS/KIND/DFT_PLUS_U.html
#          CP2K manual FORCE_EVAL/DFT (PLUS_U_METHOD)
#          https://manual.cp2k.org/trunk/CP2K_INPUT/FORCE_EVAL/DFT.html
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
&GLOBAL
  PROJECT     cp2k_dftu               # Job name (prefix for output files)
  RUN_TYPE    ENERGY_FORCE            # Single-point energy + forces
  PRINT_LEVEL LOW
&END GLOBAL

# ------------------------------------------------------------------------------
# II. FORCE EVALUATION
# ------------------------------------------------------------------------------
&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    # Method for projecting occupations onto atomic orbitals.
    # Options: MULLIKEN (default), LOWDIN, MULLIKEN_CHARGES
    # Source: CP2K manual FORCE_EVAL/DFT
    PLUS_U_METHOD MULLIKEN

    # Spin-polarized (unrestricted) calculation. Correlated oxides such as
    # FeO/NiO are magnetic; without UKS CP2K falls back to a restricted,
    # non-magnetic solution, which is usually the WRONG ground state for a
    # DFT+U study. Combine with per-kind MAGNETIZATION guesses (see &KIND).
    UKS .TRUE.

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      600                 # Higher cutoff for stable U correction
      REL_CUTOFF  60
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   RESTART             # Read from prior converged SCF (faster)
      EPS_SCF     1.0E-7              # Tight convergence for accurate forces
      MAX_SCF     300

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING

      # Metallic systems may still need smearing; uncomment if needed.
      # &SMEAR
      #   METHOD FERMI_DIRAC
      #   ELECTRONIC_TEMPERATURE [K] 300
      # &END SMEAR
      # ADDED_MOS 10                  # NOTE: ADDED_MOS is a keyword of &SCF,
                                      # not a section (no '&'). CP2K manual:
                                      # FORCE_EVAL/DFT/SCF.
    &END SCF

    &POISSON
      PERIODIC XYZ
    &END POISSON

    # --- Version gate: DFT+U and k-points (CP2K changelog 2026.2) ---
    # CP2K <  2026.2: NO &KPOINTS block may appear at all (not even
    #                 SCHEME GAMMA) — any &KPOINTS activates the k-point code
    #                 path and Mulliken DFT+U aborts with "Method not
    #                 implemented for k-points" (2026.1 runtime-verified).
    #                 Omitting &KPOINTS entirely = Gamma point (the default);
    #                 a small cell + Gamma-only means BZ undersampling, so
    #                 use a sufficiently large supercell.
    # CP2K >= 2026.2: Mulliken DFT+U supports k-points; add a converged
    #                 Monkhorst-Pack mesh, e.g.
    #                   &KPOINTS
    #                     SCHEME MONKHORST-PACK 4 4 4
    #                   &END KPOINTS
    # See https://manual.cp2k.org/trunk/changelog.html

    &PRINT
      # Print DFT+U energy and occupation matrices
      # Source: CP2K manual FORCE_EVAL/DFT/PRINT/PLUS_U
      &PLUS_U ON
      &END PLUS_U
    &END PRINT

  &END DFT

  &SUBSYS
    &CELL
      ABC     10.0 10.0 10.0
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    # NOTE: add one &KIND block per element type; place DFT+U under correlated
    # kinds. For AFM systems, split the magnetic element into two kinds with
    # opposite MAGNETIZATION initial guesses (Fe1 up / Fe2 down below), and
    # label the atoms accordingly in the coordinate file.
    &KIND Fe1                             # spin-up Fe sublattice
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
      MAGNETIZATION 4.0                   # Initial guess: N_alpha - N_beta per atom.
                                          # Fe2+ (d6, high spin) ~ +4 mu_B.

      # DFT+U parameters for this element.
      # L        : angular momentum of the correlated orbital (0=s, 1=p, 2=d, 3=f)
      # U_MINUS_J: effective Ueff = U - J (eV). This is the only parameter.
      # Source: CP2K manual FORCE_EVAL/SUBSYS/KIND/DFT_PLUS_U
      &DFT_PLUS_U ON
        L 2
        U_MINUS_J [eV] 4.0            # Fe 3d typical PBE+Ueff range: 4.0–5.0 eV
      &END DFT_PLUS_U
    &END KIND

    &KIND Fe2                             # spin-down Fe sublattice (AFM partner)
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
      MAGNETIZATION -4.0                  # Opposite initial guess -> AFM starting point.
                                          # For a ferromagnet use the same sign everywhere.

      &DFT_PLUS_U ON
        L 2
        U_MINUS_J [eV] 4.0            # Same Ueff on both magnetic sublattices
      &END DFT_PLUS_U
    &END KIND

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./coord.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

&END FORCE_EVAL

# ==============================================================================
# END OF INPUT
# ==============================================================================
# Post-processing:
# 1. Check the output for the DFT+U contribution to the total energy.
# 2. Occupation matrices are printed when &PRINT / &PLUS_U is ON.
#
# Important caveats:
# - DFT+U k-point support is version-dependent: CP2K < 2026.2 aborts on ANY
#   &KPOINTS block (even SCHEME GAMMA — "Method not implemented for k-points"),
#   so omit &KPOINTS entirely (omitting = Gamma point); CP2K >= 2026.2 supports
#   k-points with PLUS_U_METHOD MULLIKEN.
# - Magnetic correlated systems need UKS .TRUE. plus opposite MAGNETIZATION
#   initial guesses on the two sublattices to reach the AFM solution.
# - U_MINUS_J values are basis-set dependent; values from plane-wave codes
#   (e.g., VASP LDAUU) may need recalibration for CP2K Gaussian basis sets.
# - Always verify Ueff with a systematic U scan for the property of interest.
#
# CP2K vs VASP quick reference:
# - &KIND / &DFT_PLUS_U / U_MINUS_J  <=>  LDAU + LDAUL + LDAUU + LDAUJ
# - PLUS_U_METHOD MULLIKEN/LOWDIN    <=>  LDAUTYPE (2 = Liechtenstein)
# ==============================================================================
