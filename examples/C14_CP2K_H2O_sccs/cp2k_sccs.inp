# ==============================================================================
# CP2K Input | GEO_OPT with SCCS Implicit Solvent (water)
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
&GLOBAL
  PROJECT     H2O_sccs
  RUN_TYPE    GEO_OPT
  PRINT_LEVEL LOW
&END GLOBAL

# ------------------------------------------------------------------------------
# II. FORCE EVALUATION
# ------------------------------------------------------------------------------
&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      400
      REL_CUTOFF  50
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   ATOMIC
      EPS_SCF     1.0E-6
      MAX_SCF     300

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING

      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 20
      &END OUTER_SCF
    &END SCF

    # --- SCCS implicit solvent (see references/cp2k.md) ---
    &SCCS
      METHOD              ANDREUSSI
      DIELECTRIC_CONSTANT 78.36         # water
      EPS_SCCS            1.0E-7
      EPS_SCF             1.0E-6        # keep equal to DFT/SCF/EPS_SCF
      MAX_ITER            100
      MIXING              0.6
      DERIVATIVE_METHOD   FFT
      DELTA_RHO           2.0E-5
      &ANDREUSSI
        RHO_MAX 0.001
        RHO_MIN 0.0001
      &END ANDREUSSI
    &END SCCS

    &POISSON
      PERIODIC NONE                     # isolated molecule
      POISSON_SOLVER MT
    &END POISSON

  &END DFT

  &SUBSYS
    &CELL
      ABC     12.0 12.0 12.0
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC NONE
    &END CELL

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./H2O.xyz
      COORD_FILE_FORMAT  XYZ
      &CENTER_COORDINATES               # keep the molecule centered in the box
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS

&END FORCE_EVAL

# ------------------------------------------------------------------------------
# III. GEOMETRY OPTIMIZATION
# ------------------------------------------------------------------------------
&MOTION
  &GEO_OPT
    OPTIMIZER  BFGS
    MAX_ITER   100
    MAX_FORCE  4.5E-4
  &END GEO_OPT
&END MOTION

# ==============================================================================
# END OF INPUT
# ==============================================================================
# Workflow: converge gas-phase GEO_OPT first, then enable &SCCS from the restart.
# Expect 2-5x cost per SCF step with SCCS on. Check the output for
# "SCCS| Solvation free energy" — if it prints exactly zero, EPS_SCCS is too loose.
# ==============================================================================
