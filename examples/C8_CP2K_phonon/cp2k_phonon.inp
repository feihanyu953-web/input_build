# ==============================================================================
# CP2K Input | Si Bulk Phonon Force Calculation (for Phonopy)
# Sources: Phonopy + CP2K interface https://phonopy.github.io/phonopy/cp2k.html
#          CP2K phonon tutorial
#          https://www.cp2k.org/exercises:2018_uzh_cmest:phonon_calculation
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
&GLOBAL
  PROJECT     Si_phonon
  RUN_TYPE    ENERGY_FORCE
  PRINT_LEVEL LOW
&END GLOBAL

# ------------------------------------------------------------------------------
# II. FORCE EVALUATION
# ------------------------------------------------------------------------------
&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      600
      REL_CUTOFF  60
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   ATOMIC
      EPS_SCF     1.0E-7
      MAX_SCF     300

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING

      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      ADDED_MOS 100
    &END SCF

    &POISSON
      PERIODIC XYZ
    &END POISSON

    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
    &END KPOINTS

  &END DFT

  &SUBSYS
    &CELL
      ABC     5.431 5.431 5.431       # Si conventional cubic cell (Angstrom)
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    &KIND Si
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./Si_bulk.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

  # --- Output control ---
  # &FORCES belongs to FORCE_EVAL/PRINT — under DFT/PRINT CP2K aborts with
  # "unknown subsection FORCES of section PRINT" (2026.1 runtime-verified).
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT

&END FORCE_EVAL

# ==============================================================================
# PHONOPY WORKFLOW
# ==============================================================================
# Step 1: Generate displaced supercells
#   $ phonopy --cp2k -c Si_phonon.inp -d --dim="2 2 2"
#
# Step 2: Run CP2K on each displaced supercell
#   $ mpirun -np 16 cp2k.popt supercell-001.inp
#   ...
#
# Step 3: Collect forces
#   $ phonopy --cp2k -f supercell-001-forces-1_0.xyz ...
#
# Step 4: Compute phonon band structure
#   $ phonopy --cp2k -c Si_phonon.inp -p --dim="2 2 2" \
#             --band="0.0 0.0 0.0  0.5 0.0 0.5  0.375 0.375 0.0  0.0 0.0 0.0"
# ==============================================================================
