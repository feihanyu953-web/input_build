# ==============================================================================
# CP2K Input | H2O Molecule Hirshfeld Charges
# Sources: CP2K manual FORCE_EVAL/DFT/PRINT/HIRSHFELD
#          https://manual.cp2k.org/trunk/CP2K_INPUT/FORCE_EVAL/DFT/PRINT/HIRSHFELD.html
# ==============================================================================

&GLOBAL
  PROJECT     H2O_hirshfeld
  RUN_TYPE    ENERGY
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      400
      REL_CUTOFF  50
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   ATOMIC
      EPS_SCF     1.0E-7
      MAX_SCF     300

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING
    &END SCF

    # Isolated molecule (0D): pair PERIODIC NONE with a 0D-compatible solver
    # (ANALYTIC; MT / WAVELET also valid). The default PERIODIC solver is only
    # valid for fully 3D-periodic systems. See references/cp2k.md atomic block.
    &POISSON
      POISSON_SOLVER ANALYTIC
      PERIODIC NONE
    &END POISSON

    &PRINT
      &HIRSHFELD ON
        SELF_CONSISTENT F
        SHAPE_FUNCTION DENSITY        # GAUSSIAN gives O = -1.117 e and breaks charge
                                      # conservation; DENSITY gives O = -0.304 e,
                                      # H = +0.152 e, total 0.000 (2026.1 verified)
      &END HIRSHFELD
    &END PRINT

  &END DFT

  &SUBSYS
    &CELL
      ABC     10.0 10.0 10.0          # Isolated molecule in a box
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC NONE
    &END CELL

    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./H2O.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

&END FORCE_EVAL

# Post-processing: search output for "Hirshfeld Charges".
