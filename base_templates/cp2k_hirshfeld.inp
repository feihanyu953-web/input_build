# ==============================================================================
# CP2K Input | Hirshfeld Population Analysis
# Sources: CP2K manual FORCE_EVAL/DFT/PRINT/HIRSHFELD
#          https://manual.cp2k.org/trunk/CP2K_INPUT/FORCE_EVAL/DFT/PRINT/HIRSHFELD.html
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
&GLOBAL
  PROJECT     cp2k_hirshfeld          # Job name (prefix for output files)
  RUN_TYPE    ENERGY                  # Static SCF; Hirshfeld is printed from density
  PRINT_LEVEL LOW
&END GLOBAL

# ------------------------------------------------------------------------------
# II. FORCE EVALUATION
# ------------------------------------------------------------------------------
&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      400                 # Standard cutoff; increase if SCF is hard
      REL_CUTOFF  50
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   RESTART             # Read from prior converged SCF (faster)
      EPS_SCF     1.0E-7              # Tight convergence for accurate charges
      MAX_SCF     300

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING

      # For metallic systems, enable smearing:
      # &SMEAR
      #   METHOD FERMI_DIRAC
      #   ELECTRONIC_TEMPERATURE [K] 300
      # &END SMEAR
      # ADDED_MOS 10                  # NOTE: ADDED_MOS is a keyword of &SCF,
                                      # not a section (no '&'). CP2K manual:
                                      # FORCE_EVAL/DFT/SCF.
    &END SCF

    &POISSON
      PERIODIC XYZ
    &END POISSON

    # >>> USER: uncomment for bulk k-point sampling <<<
    # &KPOINTS
    #   SCHEME MONKHORST-PACK 4 4 4
    # &END KPOINTS

    &PRINT
      # Hirshfeld (spin) population analysis.
      # Source: CP2K manual FORCE_EVAL/DFT/PRINT/HIRSHFELD
      &HIRSHFELD ON
        SELF_CONSISTENT F             # T = Hirshfeld-I-like self-consistent variant
        SHAPE_FUNCTION DENSITY        # DENSITY partitions with atomic densities;
                                      # GAUSSIAN gives unphysical charges (H2O:
                                      # O = -1.117 e, total charge not conserved;
                                      # DENSITY: O = -0.304 e, H = +0.152 e,
                                      # sum 0.000 — 2026.1 runtime-verified)
      &END HIRSHFELD
    &END PRINT

  &END DFT

  &SUBSYS
    &CELL
      ABC     10.0 10.0 10.0
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    # >>> USER: add one &KIND block per element type <<<
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./coord.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

&END FORCE_EVAL

# ==============================================================================
# END OF INPUT
# ==============================================================================
# Post-processing:
# 1. Hirshfeld charges are printed in the CP2K output near the end of the SCF.
# 2. Search for "Hirshfeld Charges" or "Hirshfeld Populations" in the output.
#
# Important caveats:
# - CP2K has no built-in Bader analysis. For Bader charges, output
#   E_DENSITY_CUBE and use the external Henkelman bader program.
# - Self-consistent Hirshfeld in CP2K scales the full shape function, which is
#   not identical to the original Hirshfeld-I scheme.
#
# CP2K vs VASP quick reference:
# - &DFT / &PRINT / &HIRSHFELD  <=>  LORBIT + Bader (conceptual; CP2K prints
#                                    populations directly, VASP needs external
#                                    Bader code)
# ==============================================================================
