# ==============================================================================
# CP2K Input | Si Diamond Bulk Band Structure
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
&GLOBAL
  PROJECT     C4_CP2K_Si_band         # Job name (prefix for output files)
  RUN_TYPE    ENERGY                  # Static SCF (band structure is post-processing)
  PRINT_LEVEL MEDIUM
&END GLOBAL

# ------------------------------------------------------------------------------
# II. FORCE EVALUATION
# ------------------------------------------------------------------------------
&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
      EXTRAPOLATION USE_GUESS
    &END QS

    &MGRID
      CUTOFF      600                 # Higher cutoff for smooth bands
      REL_CUTOFF  60
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   RESTART
      EPS_SCF     1.0E-7
      MAX_SCF     300
      ADDED_MOS   10                  # Extra empty bands above Fermi level

      &DIAGONALIZATION
        ALGORITHM STANDARD
        EPS_ADAPT 0.01
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.2
        BETA     1.5
        NBROYDEN 8
      &END MIXING
    &END SCF

    &POISSON
      PERIODIC XYZ
    &END POISSON

    # -------------------------------------------------------------------------
    # K-POINT SAMPLING (SCF grid)
    # -------------------------------------------------------------------------
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
      SYMMETRY OFF
      WAVEFUNCTIONS COMPLEX
      FULL_GRID .TRUE.
      PARALLEL_GROUP_SIZE 0
    &END KPOINTS

    # -------------------------------------------------------------------------
    # BAND STRUCTURE (lives under FORCE_EVAL/DFT/PRINT, NOT &KPOINTS / &MOTION)
    # Path: seekpath get_path_orig_cell for the CONVENTIONAL cubic cell —
    # coordinates are fractional in the conventional reciprocal basis.
    # -------------------------------------------------------------------------
    &PRINT
      &BAND_STRUCTURE
        ADDED_MOS 10
        FILE_NAME band_structure.bs

        # Si diamond (Fd-3m, space group 227), conventional-cell path:
        # Gamma -> X -> U|K -> Gamma -> L -> W -> X
        &KPOINT_SET
          NPOINTS  20
          UNITS    B_VECTOR
          SPECIAL_POINT GAMMA 0.0   0.0   0.0
          SPECIAL_POINT X     0.0   1.0   0.0
          SPECIAL_POINT U     0.25  1.0   0.25
          SPECIAL_POINT K     0.75  0.75  0.0
          SPECIAL_POINT GAMMA 0.0   0.0   0.0
          SPECIAL_POINT L     0.5   0.5   0.5
          SPECIAL_POINT W     0.5   1.0   0.0
          SPECIAL_POINT X     0.0   1.0   0.0
        &END KPOINT_SET

      &END BAND_STRUCTURE
    &END PRINT

  &END DFT

  &SUBSYS
    &CELL
      ABC     5.431 5.431 5.431
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./Si_bulk.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

&END FORCE_EVAL

# ==============================================================================
# END OF INPUT
# ==============================================================================
# Post-processing:
# 1. Run SCF calculation first (or use RESTART from prior SCF)
# 2. The .bs file contains k-point energies
# 3. Convert to CSV: cp2k_bs2csv.py C4_CP2K_Si_band.bs
# 4. Plot with matplotlib / gnuplot / sumo-bandplot
# ==============================================================================
