# ==============================================================================
# LAMMPS Input Script | Machine-Learning Force Field (MLFF) MD
# Generated by input-build
# ==============================================================================
# MLFF-specific notes vs classical MD:
# - NO kspace (MLFFs are local); NO bonds (atom_style atomic)
# - The element order in pair_coeff MUST match the type order in the data file
#   (type 1 = first element listed, type 2 = second, ...) — the #1 silent-error source
# - Some MLFF pair styles require `newton off` — check the docs of your build
# ==============================================================================

# ==============================================================================
# 1. SIMULATION ENVIRONMENT
# ==============================================================================
units           metal               # eV, A, ps, K, bar
atom_style      atomic              # MLFF: no bond topology
boundary        p p p               # use p p f for slab interfaces if needed
newton          on                  # set `newton off` if your MLFF pair style requires it

# ==============================================================================
# 2. SYSTEM SETUP
# ==============================================================================
read_data       system.data         # Type order MUST match pair_coeff element order!
# replicate       2 2 1

# ==============================================================================
# 3. FORCE FIELD (Machine-Learning Potential)
# ==============================================================================
# >>> USER: uncomment ONE variant and fill in your model path + element list <<<
#
# --- MACE ---
# pair_style      mace
# pair_coeff      * * mace.model H O Pt N Na
#
# --- DeepMD ---
# pair_style      deepmd graph.pb
# pair_coeff      * *
#
# --- PaCÉ (atomic cluster expansion) ---
# pair_style      pace
# pair_coeff      * * potential.yace H O Pt
#
# Rules: (1) element order = data-file type order; (2) never invent a model file;
# (3) no kspace_style for any of these.

# ==============================================================================
# 4. ENERGY MINIMIZATION
# ==============================================================================
min_style       cg
minimize        1.0e-4 1.0e-6 1000 10000

# ==============================================================================
# 5. TEMPERATURE INITIALIZATION
# ==============================================================================
velocity        all create 300.0 12345 dist gaussian
# velocity      all zero linear

# ==============================================================================
# 6. EQUILIBRATION
# ==============================================================================
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        0.0005              # 0.5 fs, safe for H; 0.001-0.002 for heavy-only systems

fix             equil all nvt temp 300.0 300.0 0.05
thermo          100
thermo_style    custom step temp press pe ke etotal vol density
run             20000               # 10 ps
unfix           equil

# ==============================================================================
# 7. PRODUCTION
# ==============================================================================
fix             prod all nvt temp 300.0 300.0 0.05

# --- Trajectory: include forces (active-learning / error-estimation workflows) ---
dump            1 all custom 100 traj.lammpstrj id type x y z fx fy fz
dump_modify     1 sort id

restart         10000 restart1.restart restart2.restart

run             200000              # 100 ps at 0.5 fs

# ==============================================================================
# END OF INPUT
# ==============================================================================
# Post-run notes:
# - Watch energy/temperature drift closely in the first 10 ps — MLFF failures are
#   usually abrupt (atoms ejected, energy explosion) rather than gradual.
# - For interface water: verify density profiles against AIMD or experiment before
#   trusting ns-scale MLFF statistics.
# ==============================================================================
