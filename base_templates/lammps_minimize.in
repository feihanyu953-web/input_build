# ==============================================================================
# LAMMPS Input Script | Energy Minimization Only
# Generated by input-build
# ==============================================================================

# ==============================================================================
# 1. SIMULATION ENVIRONMENT
# ==============================================================================
units           metal               # eV, Å, ps, K, bar
atom_style      atomic              # For MLFF/most potentials (no bond info)
boundary        p p p               # 3D periodic (slab: use p p f, z = surface normal)
newton          on                  # Default; set off for GPU Kokkos if needed

# ==============================================================================
# 2. SYSTEM SETUP
# ==============================================================================
read_data       system.data         # Atomic coordinates, box, element types
# NOTE: Element order in data file must match pair_coeff order in Section 3

# (Optional) Replicate if supercell needed
# replicate       2 2 1

# ==============================================================================
# 3. FORCE FIELD (User-defined)
# ==============================================================================
# >>> INSERT YOUR POTENTIAL DEFINITION BELOW <<<
#
# Examples:
#
# >>> USER: insert pair_style/pair_coeff here (REQUIRED - examples below) <<<
#
# --- EAM ---
# File format determines pair_style AND pair_coeff arity
# (https://docs.lammps.org/pair_eam.html):
#   funcfl single-element (*.eam, e.g. Cu_u3.eam, Al_u3.eam) -> pair_style eam
#     pair_coeff takes exactly 3 args (* * file) with NO element symbol —
#     pair_eam.cpp enforces narg == 3; a 4th arg (element symbol) aborts with
#     "Incorrect args for pair coefficients" (22Jul2025 runtime-verified)
#   setfl alloy (*.eam.alloy, e.g. Al99.eam.alloy)           -> pair_style eam/alloy
#     pair_coeff REQUIRES element symbol(s) after the file
# A mismatched format/style pair aborts with a potential-file parse error.
# pair_style      eam
# pair_coeff      * * Cu_u3.eam
#
# pair_style      eam/alloy
# pair_coeff      * * Al99.eam.alloy Al
#
# --- DeepMD ---
# pair_style      deepmd graph.pb
# pair_coeff      * *
#
# --- MACE ---
# pair_style      mace
# pair_coeff      * * mace.model H O Pt N Na
#
# --- ReaxFF (requires REAXFF package) ---
# NOTE: the legacy REAX-C pair style was removed in LAMMPS 2024+; use reaxff.
# Hard requirements: atom_style charge (or full) for per-atom charge,
# plus fix qeq/reaxff charge equilibration; units real is conventional.
# atom_style      charge
# pair_style      reaxff NULL
# pair_coeff      * * ffield.reax C H O N
# fix             qeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff

# ==============================================================================
# 4. ENERGY MINIMIZATION (Multi-stage)
# ==============================================================================
# Stage 1: Steepest descent (robust for bad contacts / overlapping atoms)
min_style       sd
minimize        1.0e-4 1.0e-6 1000 10000
#                 etol   ftol   maxiter maxeval

# Stage 2: Conjugate gradient (faster convergence near minimum)
# Only run if Stage 1 did not fully converge
min_style       cg
minimize        1.0e-6 1.0e-8 1000 10000

# Stage 3: FIRE (optional, for complex energy landscapes)
# min_style     fire
# minimize      1.0e-6 1.0e-8 1000 10000

# ==============================================================================
# 5. POST-MINIMIZATION OUTPUT
# ==============================================================================
# Write minimized structure
write_data      minimized.data

# Write restart for MD continuation (positions + box; re-declare fixes for MD)
write_restart   minimized.restart

# Print final energy and forces
thermo          1
thermo_style    custom step pe press vol density
run             0                   # Zero-step run to print final thermo

# ==============================================================================
# END OF INPUT
# ==============================================================================
# Post-run notes:
# - Check log.lammps for "Minimization stats:" final energy and max force
# - If max force > 1.0e-3 eV/Å, increase maxiter/maxeval in minimize, or
#   shrink the per-step atom displacement via min_modify (e.g. min_modify dmax 0.05)
# - If minimization hits maxiter, system may be stuck; try sd → fire → cg
# - For relaxation with box changes, use fix box/relax or switch to NPT MD
# ==============================================================================
