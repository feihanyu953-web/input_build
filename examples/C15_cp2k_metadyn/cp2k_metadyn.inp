# ==============================================================================
# C15 · CP2K well-tempered metadynamics: water dimer O-O distance CV
# ==============================================================================

&GLOBAL
  PROJECT     c15_cp2k_metadyn
  RUN_TYPE    MD
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      400
      REL_CUTOFF  50
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   RESTART
      EPS_SCF     1.0E-6
      MAX_SCF     300

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING
    &END SCF

    &POISSON
      PERIODIC XYZ
    &END POISSON
  &END DFT

  &SUBSYS
    &CELL
      ABC     10.0 10.0 10.0
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    # CV1: O-O distance of the water dimer (atoms 1 and 4 in coord.xyz)
    &COLVAR
      &DISTANCE
        ATOMS 1 4
      &END DISTANCE
    &END COLVAR

    &TOPOLOGY
      COORD_FILE_NAME    ./coord.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

&END FORCE_EVAL

&MOTION
  &MD
    ENSEMBLE    NVT
    STEPS       5000
    TIMESTEP    0.5                   # fs; H present -> <= 0.5
    TEMPERATURE 300.0

    &THERMOSTAT
      TYPE        CSVR
      &CSVR
        TIMECON   100.0
      &END CSVR
    &END THERMOSTAT
  &END MD

  &FREE_ENERGY
    &METADYN
      DO_HILLS  .TRUE.
      NT_HILLS  100                   # spawn a hill every 100 MD steps
      WW        [kcalmol] 1.5         # hill height (typical 0.5-2 kcal/mol)

      &METAVAR
        SCALE     0.5                 # hill width (A) along the O-O distance
        COLVAR    1
        # Bound the CV space (dimer must not evaporate apart):
        # TYPE QUARTIC + POSITION is already an upper wall; CP2K &WALL has no
        # DIRECTION keyword — WALL_PLUS is PLUMED UPPER_WALLS syntax (2026.1 aborts).
        &WALL
          TYPE      QUARTIC
          POSITION  [angstrom] 5.0
          &QUARTIC
            K [kcalmol] 40.0
          &END QUARTIC
        &END WALL
      &END METAVAR

      WELL_TEMPERED .TRUE.
      WTGAMMA     20                  # bias factor (typical 10-50)

      &PRINT
        &COLVAR
          COMMON_ITERATION_LEVELS 3
          &EACH
            MD    10
          &END EACH
        &END COLVAR
        &HILLS
          COMMON_ITERATION_LEVELS 3
          &EACH
            MD    10
          &END EACH
        &END HILLS
      &END PRINT
    &END METADYN
  &END FREE_ENERGY

  &PRINT
    &TRAJECTORY
      FORMAT     XYZ
      &EACH
        MD       10
      &END EACH
    &END TRAJECTORY
  &END PRINT
&END MOTION
