# ==============================================================================
# CP2K Input | Projected Density of States (PDOS)
# Sources: CP2K DOS manual
#          https://manual.cp2k.org/trunk/methods/electronic_structure/dos.html
#          CP2K PDOS tutorial:
#          https://www.cp2k.org/exercises:common:pdos
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
&GLOBAL
  PROJECT     cp2k_dos                # Job name (prefix for output files)
  RUN_TYPE    ENERGY                  # Static SCF; PDOS is post-processed
  PRINT_LEVEL LOW
&END GLOBAL

# ------------------------------------------------------------------------------
# II. FORCE EVALUATION
# ------------------------------------------------------------------------------
&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      600                 # Higher cutoff for accurate eigenvalues
      REL_CUTOFF  60
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   RESTART             # Read from prior converged SCF (faster)
      EPS_SCF     1.0E-7              # Tight convergence for accurate eigenvalues
      MAX_SCF     300
      ADDED_MOS   100                 # Extra empty bands needed for DOS/PDOS

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.2                  # Smaller mixing for k-point stability
        BETA     1.5
        NBROYDEN 8
      &END MIXING

      # For metallic systems, enable smearing:
      # &SMEAR
      #   METHOD FERMI_DIRAC
      #   ELECTRONIC_TEMPERATURE [K] 300
      # &END SMEAR
      # Robustness note (2026.1 runtime-verified): enable SMEARING even for
      # semiconductors/insulators when running Gamma-only small cells or with
      # large ADDED_MOS — a 2-atom Si cell without smearing oscillated for the
      # full 300 SCF steps; with FERMI_DIRAC 300 K it converged in 12-23 steps.
    &END SCF

    &POISSON
      PERIODIC XYZ
    &END POISSON

    # >>> USER: uncomment for bulk metal / semiconductor k-point sampling <<<
    # WARNING (2026.1 runtime-verified): &KPOINTS and &PDOS are mutually
    # exclusive — with k-points CP2K only warns "pDOS is not implemented for
    # k points" and writes NO PDOS files (easy to miss). For PDOS output,
    # leave &KPOINTS commented out (Gamma-only); run the k-mesh as a
    # separate SCF if you also need band-quality eigenvalues.
    # &KPOINTS
    #   SCHEME MONKHORST-PACK 4 4 4
    # &END KPOINTS

    &PRINT
      &PDOS
        NLUMO    -1                   # Print all unoccupied states (-1 = all)
        COMPONENTS                    # Split into s, px, py, pz, d, ...
        # DELTA_E  0.05               # Energy grid spacing (eV); default usually OK
        # BROADEN_WIDTH 0.1           # Gaussian broadening (eV)
        # ENERGY_ZERO FERMI           # Reference: FERMI / HOCO / ABSOLUTE / AUTO
      &END PDOS
    &END PRINT

  &END DFT

  &SUBSYS
    &CELL
      ABC     10.0 10.0 10.0
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    # >>> USER: add one &KIND block per element type <<<
    &KIND Ti
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./coord.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

&END FORCE_EVAL

# ==============================================================================
# END OF INPUT
# ==============================================================================
# Post-processing:
# 1. Run SCF calculation first (or use RESTART from prior SCF).
# 2. PDOS files are written per kind: *kind*-ALPHA_k*-1_*.pdos
# 3. Plot with cp2kdata, matplotlib, or sumo.
#
# For large systems or metals, consider a dense k-grid and Fermi smearing.
# ==============================================================================
