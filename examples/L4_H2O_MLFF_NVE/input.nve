# ==============================================================================
# LAMMPS Input Script | H2O Molecule NVE with MLFF
# Generated by input-build
# ==============================================================================
# System: 1 H2O molecule in a 20 Å box (isolated molecule)
# ==============================================================================

# ==============================================================================
# 1. SIMULATION ENVIRONMENT
# ==============================================================================
units           metal               # eV, Å, ps, K, bar
atom_style      atomic              # For MLFF (no bond info)
boundary        p p p               # 3D periodic (large box approximates isolation)
newton          on

# ==============================================================================
# 2. SYSTEM SETUP
# ==============================================================================
read_data       system.data
velocity        all create 300.0 12345 dist gaussian
# velocity      all zero linear      # Uncomment to remove COM drift

# ==============================================================================
# 3. FORCE FIELD (MACE)
# ==============================================================================
pair_style      mace
pair_coeff      * * mace.model H O

# ==============================================================================
# 4. NVE PRODUCTION (Microcanonical — check energy conservation)
# ==============================================================================
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        0.0005              # 0.5 fs (safe for H-containing systems)

# NVE integrator (no thermostat)
fix             prod all nve

thermo          100
thermo_style    custom step temp press pe ke etotal vol density cpu

# Trajectory: unwrapped coordinates (xu yu zu) for MSD analysis
dump            1 all custom 100 traj.lammpstrj id type xu yu zu vx vy vz
dump_modify     1 sort id

restart         10000 restart1.restart restart2.restart

run             200000              # 100 ps production

# ==============================================================================
# END OF INPUT
# ==============================================================================
# Post-run validation:
# 1. Energy conservation: plot etotal vs step; drift should be < 1 meV/atom/ps
# 2. Temperature drift: expected for NVE; should equilibrate around target T
# 3. If energy drifts upward: reduce timestep or check potential cutoff
# ==============================================================================
