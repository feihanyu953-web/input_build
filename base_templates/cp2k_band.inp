# ==============================================================================
# CP2K Input | Band Structure (SCF + k-path)
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
&GLOBAL
  PROJECT     cp2k_band               # Job name (prefix for output files)
  RUN_TYPE    ENERGY                  # Static SCF (band structure is post-processing)
  PRINT_LEVEL MEDIUM
&END GLOBAL

# ------------------------------------------------------------------------------
# II. FORCE EVALUATION
# ------------------------------------------------------------------------------
&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
      EXTRAPOLATION USE_GUESS       # Required for k-point calculations
    &END QS

    &MGRID
      CUTOFF      600                 # Higher cutoff for smooth bands (Ry)
      REL_CUTOFF  60
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   RESTART             # Read from prior converged SCF (faster)
      EPS_SCF     1.0E-7              # Tight convergence for accurate eigenvalues
      MAX_SCF     300
      ADDED_MOS   10                  # Extra empty bands above Fermi level

      &DIAGONALIZATION
        ALGORITHM STANDARD
        EPS_ADAPT 0.01                # Adaptive diagonalization threshold
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.2                  # Smaller mixing for k-point SCF stability
        BETA     1.5
        NBROYDEN 8
      &END MIXING

      # Smearing recommended for band structure (ensures smooth DOS)
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
    &END SCF

    &POISSON
      PERIODIC XYZ
    &END POISSON

    # -------------------------------------------------------------------------
    # K-POINT SAMPLING (SCF grid)
    # -------------------------------------------------------------------------
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4     # NOTE: adjust mesh density per system (converge k-points)
      SYMMETRY OFF                    # Disable k-point symmetry for safety
      WAVEFUNCTIONS COMPLEX           # COMPLEX is required for a general k-mesh.
                                      # REAL is only valid for Gamma-only or special
                                      # Bloch phases where wavefunctions stay real
                                      # (see CP2K manual methods/dft/k-points).
      FULL_GRID .TRUE.                # Use full k-grid (no symmetry reduction)
      PARALLEL_GROUP_SIZE 0           # Auto-determine parallelization
    &END KPOINTS

    # -------------------------------------------------------------------------
    # BAND STRUCTURE (must live under FORCE_EVAL/DFT/PRINT, NOT &KPOINTS/&MOTION)
    # >>> MANDATORY: replace with high-symmetry path for YOUR crystal <<<
    # The example below is for the CONVENTIONAL FCC cell (Fm-3m, e.g. Al, Cu):
    # coordinates are fractional in the conventional reciprocal basis
    # (seekpath get_path_orig_cell). Primitive/supercell inputs need different
    # coordinates — generate yours with seekpath or scripts/kpoints_helper.py.
    # -------------------------------------------------------------------------
    &PRINT
      &BAND_STRUCTURE
        ADDED_MOS 10
        FILE_NAME band_structure.bs

        # Example: conventional-FCC path (Γ → X → W → L → Γ → K)
        &KPOINT_SET
          NPOINTS  20
          UNITS    B_VECTOR           # Reciprocal lattice vector units
          SPECIAL_POINT GAMMA 0.0   0.0   0.0
          SPECIAL_POINT X     0.0   1.0   0.0
          SPECIAL_POINT W     0.5   1.0   0.0
          SPECIAL_POINT L     0.5   0.5   0.5
          SPECIAL_POINT GAMMA 0.0   0.0   0.0
          SPECIAL_POINT K     0.75  0.75  0.0
        &END KPOINT_SET

      &END BAND_STRUCTURE
    &END PRINT

  &END DFT

  &SUBSYS
    &CELL
      ABC     10.0 10.0 10.0
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    # >>> USER: add one &KIND block per element type <<<
    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./coord.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

&END FORCE_EVAL

# ==============================================================================
# END OF INPUT
# ==============================================================================
# Post-processing:
# 1. Run SCF calculation first (or use RESTART from prior SCF)
# 2. The .bs file contains k-point energies
# 3. Convert to CSV: cp2k_bs2csv.py your_project.bs
# 4. Plot with matplotlib / gnuplot / sumo-bandplot
#
# IMPORTANT:
# - OT (Orbital Transformation) is NOT supported with k-points
# - Use full diagonalization (&DIAGONALIZATION) only
# - UNITS B_VECTOR is recommended (CART_BOHR has known bugs)
# - Always verify k-path with SeeK-path for your space group
# ==============================================================================
