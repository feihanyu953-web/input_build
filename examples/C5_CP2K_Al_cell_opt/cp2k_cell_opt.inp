# ==============================================================================
# CP2K Input | Al FCC Bulk Cell Optimization (BFGS, direct cell opt)
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
&GLOBAL
  PROJECT     C5_CP2K_Al_cell_opt     # Job name (prefix for output files)
  RUN_TYPE    CELL_OPT                # Cell + geometry simultaneous optimization
  PRINT_LEVEL LOW
&END GLOBAL

# ------------------------------------------------------------------------------
# II. FORCE EVALUATION
# ------------------------------------------------------------------------------
&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL            # REQUIRED for cell optimization

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      400
      REL_CUTOFF  50
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   ATOMIC
      EPS_SCF     1.0E-6
      MAX_SCF     300

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING

      # Fermi-Dirac smearing for metallic Al
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      ADDED_MOS 10
    &END SCF

    &POISSON
      PERIODIC XYZ
    &END POISSON

    # K-points for accurate stress/pressure in bulk metal
    &KPOINTS
      SCHEME MONKHORST-PACK 9 9 9
      SYMMETRY OFF
      WAVEFUNCTIONS COMPLEX
      FULL_GRID .TRUE.
    &END KPOINTS

  &END DFT

  &SUBSYS
    &CELL
      ABC     4.0495 4.0495 4.0495
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    &KIND Al
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./Al_bulk.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

  # --- Output control ---
  # &FORCES belongs to FORCE_EVAL/PRINT — under DFT/PRINT CP2K aborts with
  # "unknown subsection FORCES of section PRINT" (2026.1 runtime-verified).
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT

&END FORCE_EVAL

# ------------------------------------------------------------------------------
# III. CELL OPTIMIZATION
# ------------------------------------------------------------------------------
&MOTION
  &CELL_OPT
    OPTIMIZER    BFGS
    # CP2K <= 2026.1: keep TYPE (DIRECT_CELL_OPT recommended).
    # CP2K >= 2026.2: TYPE keyword removed from &CELL_OPT — delete the line
    # below (direct cell optimization is then implicit). CP2K changelog.
    TYPE         DIRECT_CELL_OPT     # DELETE this line for CP2K >= 2026.2
    MAX_ITER     200
    MAX_DR       3.0E-3
    RMS_DR       1.5E-3
    MAX_FORCE    4.5E-4
    RMS_FORCE    3.0E-4

    EXTERNAL_PRESSURE    1.01325       # 1 atm = 1.01325 bar
    PRESSURE_TOLERANCE   100.0

    &PRINT
      &CELL ON
      &END CELL
    &END PRINT
  &END CELL_OPT

  # --- Trajectory output ---
  # &TRAJECTORY belongs to MOTION/PRINT — &CELL_OPT/&PRINT/&TRAJECTORY is not
  # a valid subsection (2026.1 runtime-verified).
  &PRINT
    &TRAJECTORY
      FORMAT XYZ
    &END TRAJECTORY
  &END PRINT
&END MOTION

# ==============================================================================
# END OF INPUT
# ==============================================================================
