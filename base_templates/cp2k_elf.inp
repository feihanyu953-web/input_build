# ==============================================================================
# CP2K Input | Electron Localization Function (ELF) Cube
# Sources: CP2K manual FORCE_EVAL/DFT/PRINT/ELF_CUBE
#          https://manual.cp2k.org/trunk/CP2K_INPUT/FORCE_EVAL/DFT/PRINT/ELF_CUBE.html
#          CP2K manual FORCE_EVAL/DFT/PRINT/E_DENSITY_CUBE
#          https://manual.cp2k.org/trunk/CP2K_INPUT/FORCE_EVAL/DFT/PRINT/E_DENSITY_CUBE.html
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
&GLOBAL
  PROJECT     cp2k_elf                # Job name (prefix for output files)
  RUN_TYPE    ENERGY                  # Static SCF; ELF is printed from density
  PRINT_LEVEL LOW
&END GLOBAL

# ------------------------------------------------------------------------------
# II. FORCE EVALUATION
# ------------------------------------------------------------------------------
&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      600                 # Higher cutoff for smooth ELF isosurfaces
      REL_CUTOFF  60
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   RESTART             # Read from prior converged SCF (faster)
      EPS_SCF     1.0E-7              # Tight convergence for accurate density
      MAX_SCF     300

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING

      # For metallic systems, enable smearing:
      # &SMEAR
      #   METHOD FERMI_DIRAC
      #   ELECTRONIC_TEMPERATURE [K] 300
      # &END SMEAR
      # Robustness note (2026.1 runtime-verified): enable SMEARING even for
      # semiconductors/insulators when running Gamma-only small cells or with
      # large ADDED_MOS — a 2-atom Si cell without smearing oscillated for the
      # full 300 SCF steps; with FERMI_DIRAC 300 K it converged in 12-23 steps.
      # ADDED_MOS 10                  # NOTE: ADDED_MOS is a keyword of &SCF,
                                      # not a section (no '&'). CP2K manual:
                                      # FORCE_EVAL/DFT/SCF.
    &END SCF

    &POISSON
      PERIODIC XYZ
    &END POISSON

    # >>> USER: uncomment for bulk k-point sampling <<<
    # &KPOINTS
    #   SCHEME MONKHORST-PACK 4 4 4
    # &END KPOINTS

    &PRINT
      # Electron localization function cube.
      # Source: CP2K manual FORCE_EVAL/DFT/PRINT/ELF_CUBE
      &ELF_CUBE ON
        STRIDE 2 2 2                  # Larger stride = smaller files; 1 1 1 = finest
      &END ELF_CUBE

      # Optional: also write the electron density cube (useful for Bader
      # post-processing with the external Henkelman bader program).
      # Source: CP2K manual FORCE_EVAL/DFT/PRINT/E_DENSITY_CUBE
      # &E_DENSITY_CUBE ON
      #   STRIDE 2 2 2
      # &END E_DENSITY_CUBE
    &END PRINT

  &END DFT

  &SUBSYS
    &CELL
      ABC     10.0 10.0 10.0
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    # >>> USER: add one &KIND block per element type <<<
    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./coord.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

&END FORCE_EVAL

# ==============================================================================
# END OF INPUT
# ==============================================================================
# Post-processing:
# 1. ELF cube files are written with the prefix set by FILENAME (default *elf*).
# 2. Visualize with VMD, VESTA, ovito, or UCSF Chimera.
#
# Common isosurfaces:
#   - ELF = 0.85: covalent bonds / lone pairs
#   - ELF = 0.5 : electron-gas-like region
#   - ELF = 0.0 : vacuum / strongly delocalized
#
# Important caveats:
# - In GAPW, add DENSITY_INCLUDE TOTAL_HARD_APPROX under &QS to avoid
#   hard-density artifacts.
# - ELF_CUBE and E_DENSITY_CUBE are separate print keys.
#
# CP2K vs VASP quick reference:
# - &DFT / &PRINT / &ELF_CUBE  <=>  LELF = .TRUE. (writes ELFCAR)
# - &DFT / &PRINT / &E_DENSITY_CUBE  <=>  LCHARG = .TRUE. (writes CHGCAR)
# ==============================================================================
