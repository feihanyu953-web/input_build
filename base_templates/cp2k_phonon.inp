# ==============================================================================
# CP2K Input | Phonon Calculation via Phonopy (Force Evaluation)
# Sources: Phonopy + CP2K interface https://phonopy.github.io/phonopy/cp2k.html
#          CP2K phonon tutorial
#          https://www.cp2k.org/exercises:2018_uzh_cmest:phonon_calculation
# Note:    CP2K's built-in &VIBRATIONAL_ANALYSIS is mainly for molecules/IR.
#          For periodic solids, CP2K + Phonopy is the standard workflow.
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
&GLOBAL
  PROJECT     cp2k_phonon             # Job name (prefix for output files)
  RUN_TYPE    ENERGY_FORCE            # Forces required by Phonopy
  PRINT_LEVEL LOW
&END GLOBAL

# ------------------------------------------------------------------------------
# II. FORCE EVALUATION
# ------------------------------------------------------------------------------
&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      600                 # Higher cutoff for accurate forces
      REL_CUTOFF  60
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   ATOMIC              # Start from scratch for each displacement
      EPS_SCF     1.0E-7              # Tight convergence for accurate forces
      MAX_SCF     300

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING

      # For metallic systems, enable smearing:
      # &SMEAR
      #   METHOD FERMI_DIRAC
      #   ELECTRONIC_TEMPERATURE [K] 300
      # &END SMEAR
      # ADDED_MOS 100                  # Extra empty bands for smearing
    &END SCF

    &POISSON
      PERIODIC XYZ
    &END POISSON

    # >>> USER: uncomment for bulk systems <<<
    # &KPOINTS
    #   SCHEME MONKHORST-PACK 4 4 4
    # &END KPOINTS

  &END DFT

  &SUBSYS
    &CELL
      ABC     5.466 5.466 5.466       # Example: Si conventional cubic cell (Angstrom)
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    # >>> USER: add one &KIND block per element type <<<
    &KIND Si
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./coord.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

  # --- Output control ---
  # &FORCES belongs to FORCE_EVAL/PRINT — under DFT/PRINT CP2K aborts with
  # "unknown subsection FORCES of section PRINT" (2026.1 runtime-verified).
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT

&END FORCE_EVAL

# ==============================================================================
# PHONOPY WORKFLOW INSTRUCTIONS
# ==============================================================================
# This input is used to compute forces on displaced supercells.
#
# Step 1: Generate displaced supercells
#   $ phonopy --cp2k -c cp2k_phonon.inp -d --dim="2 2 2"
#   This creates supercell.inp, supercell-001.inp, ...
#
# Step 2: Run CP2K on each displaced supercell
#   $ mpirun -np 16 cp2k.popt supercell-001.inp
#   ...
#
# Step 3: Collect forces
#   $ phonopy --cp2k -f supercell-001-forces-1_0.xyz ...
#
# Step 4: Compute phonon band structure / DOS
#   $ phonopy --cp2k -c cp2k_phonon.inp -p --dim="2 2 2" \
#             --band="0.0 0.0 0.0  0.5 0.0 0.5  0.375 0.375 0.0  0.0 0.0 0.0"
#
# For more details see: https://phonopy.github.io/phonopy/cp2k.html
# ==============================================================================
