# plumed.dat — placeholder sample for L8 (DISTANCE CV + PRINT)
# On restart, PLUMED needs its own RESTART keyword at the top of this file.

d1: DISTANCE ATOMS=1,2

PRINT ARG=d1 FILE=COLVAR STRIDE=10

# --- Metadynamics variant (uncomment to bias along d1) ---
