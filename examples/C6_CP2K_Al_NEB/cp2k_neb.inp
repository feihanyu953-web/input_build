# ==============================================================================
# CP2K Input | H Diffusion on Al(100) CI-NEB (5 replicas)
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
&GLOBAL
  PROJECT     C6_CP2K_Al_NEB          # Job name (prefix for output files)
  RUN_TYPE    BAND                    # BAND = NEB in CP2K terminology
  PRINT_LEVEL LOW
&END GLOBAL

# ------------------------------------------------------------------------------
# II. FORCE EVALUATION (single replica template; repeated for each image)
# ------------------------------------------------------------------------------
&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      400
      REL_CUTOFF  50
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   RESTART
      EPS_SCF     1.0E-6
      MAX_SCF     300

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING
    &END SCF

    &POISSON
      PERIODIC XYZ
    &END POISSON

  &END DFT

  &SUBSYS
    &CELL
      ABC     7.848 7.848 20.0
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &KIND Al
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    # REQUIRED even for NEB: &REPLICA coordinates do NOT exempt &SUBSYS from
    # providing a coordinate source — without one CP2K 2026.1 aborts in
    # topology.F with "No atomic coordinates" (runtime-verified). The initial
    # state is used here; each &REPLICA below overrides it per image.
    &TOPOLOGY
      COORD_FILE_NAME    ./Al_NEB_initial.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

&END FORCE_EVAL

# ------------------------------------------------------------------------------
# III. NEB / BAND MOTION
# ------------------------------------------------------------------------------
&MOTION
  &BAND
    # Total CPUs = NPROC_REP × NUMBER_OF_REPLICA = 4 × 5 = 20
    NPROC_REP        4
    NUMBER_OF_REPLICA 5

    BAND_TYPE        CI-NEB
    K_SPRING         0.05

    &CONVERGENCE_CONTROL
      MAX_FORCE  4.5E-4
      RMS_FORCE  3.0E-4
      MAX_DR     3.0E-3
      RMS_DR     1.5E-3
    &END CONVERGENCE_CONTROL

    ROTATE_FRAMES    F
    ALIGN_FRAMES     F

    &CI_NEB
      NSTEPS_IT  5
    &END CI_NEB

    &OPTIMIZE_BAND
      OPT_TYPE   DIIS
      &DIIS
        NO_LS      T
        MAX_STEPS  1000
        N_DIIS     3
      &END DIIS
    &END OPTIMIZE_BAND

    # --- Replica definitions ---
    &REPLICA
      COORD_FILE_NAME  ./Al_NEB_initial.xyz
    &END REPLICA

    &REPLICA
      COORD_FILE_NAME  ./Al_NEB_final.xyz
    &END REPLICA

    &PROGRAM_RUN_INFO
      INITIAL_CONFIGURATION_INFO
    &END PROGRAM_RUN_INFO

  &END BAND
&END MOTION

# ==============================================================================
# END OF INPUT
# ==============================================================================
