# ==============================================================================
# VASP INCAR | AIMD NVT (Langevin Thermostat)
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
SYSTEM   = Pt100_6x6_NH3_NaOH AIMD      # Pt(100) slab + solvated NH3/NaOH
PREC     = Normal                       # Normal precision; ENCUT manually controlled
ENCUT    = 400                          # Plane-wave cutoff (eV); >= max ENMAX in POTCAR

# ------------------------------------------------------------------------------
# II. ELECTRONIC SCF
# ------------------------------------------------------------------------------
ALGO     = Normal                       # Normal Davidson/RMM-DIIS; robust for MD start
EDIFF    = 1E-5                         # SCF energy convergence (eV); looser OK for MD
ISMEAR   = 0                            # Gaussian smearing (metal slab)
SIGMA    = 0.1                          # Smearing width (eV)
NELMIN   = 4                            # Min SCF steps; MD can converge faster
NELM     = 60                           # Max SCF steps per MD step; prevent stall

# ------------------------------------------------------------------------------
# III. MOLECULAR DYNAMICS
# ------------------------------------------------------------------------------
IBRION   = 0                            # MD mode (no geometry optimization)
MDALGO   = 3                            # Langevin thermostat (stochastic, good for NVT)
ISIF     = 2                            # Fix cell shape / volume; relax ions only
POTIM    = 1.0                          # Time step (fs); standard for H-containing systems
                                        # VALIDATION: check first 100 steps ion displacement < 0.1 A
                                        # If exceeded, reduce to 0.5 fs
NSW      = 5000                         # Total MD steps; 5 ps at 1 fs/step (extend as needed)
TEBEG    = 330                          # Starting temperature (K)
TEEND    = 330                          # Target temperature (K)
RANDOM_SEED = 12345 0 0                   # Three integers required by VASP 6.x
                                          # (vasp.at/wiki/RANDOM_SEED); fix seed for
                                          # reproducible stochastic MD

# Langevin friction: element-specific values in POSCAR element order (ps^-1)
# POSCAR element order: Pt   O    H    Na   N
# Pt (heavy) needs weaker coupling; H (light) needs stronger coupling
LANGEVIN_GAMMA = 1.0  5.0  10.0  5.0  5.0

# ------------------------------------------------------------------------------
# IV. ACCURACY
# ------------------------------------------------------------------------------
ADDGRID  = .TRUE.                       # Finer FFT grid for accurate forces in MD
LASPH    = .TRUE.                       # Non-spherical contributions in PAW
LREAL    = Auto                         # Real-space projection for large cells (>100 atoms)
ISYM     = 0                            # Disable symmetry; required for MD

# ------------------------------------------------------------------------------
# V. I/O CONTROL (AIMD: turn OFF large file writes to avoid GB-level IO)
# ------------------------------------------------------------------------------
LWAVE    = .FALSE.                      # Do NOT write WAVECAR at every MD step
LCHARG   = .FALSE.                      # Do NOT write CHGCAR at every MD step

# ------------------------------------------------------------------------------
# VI. PARALLELIZATION (hardware-dependent; uncomment and adjust on cluster)
# ------------------------------------------------------------------------------
# NCORE  = 4                            # Orbitals per core; tune for your queue / node
# NPAR   = 4                            # Bands parallelized over NPAR groups
# KPAR   = 1                            # K-point parallelization; >1 only if multiple kpts

# END OF INCAR
