# ==============================================================================
# CP2K Input | FeO Rocksalt DFT+U (PBE+Ueff on Fe 3d)
# Sources: CP2K manual FORCE_EVAL/SUBSYS/KIND/DFT_PLUS_U
#          https://manual.cp2k.org/trunk/CP2K_INPUT/FORCE_EVAL/SUBSYS/KIND/DFT_PLUS_U.html
# ==============================================================================

&GLOBAL
  PROJECT     FeO_dftu
  RUN_TYPE    ENERGY_FORCE
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    PLUS_U_METHOD MULLIKEN

    # Spin-polarized calculation: FeO is an antiferromagnetic Mott/charge-
    # transfer insulator. Without UKS, CP2K converges to a restricted
    # non-magnetic solution — the wrong ground state for DFT+U.
    UKS .TRUE.

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      600
      REL_CUTOFF  60
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   RESTART
      EPS_SCF     1.0E-7
      MAX_SCF     300

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING

      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      ADDED_MOS 10
    &END SCF

    &POISSON
      PERIODIC XYZ
    &END POISSON

    # Version gate (DFT+U x k-points, 2026.1 runtime-verified):
    #   CP2K <  2026.2: NO &KPOINTS block may appear at all — even SCHEME GAMMA
    #                   activates the k-point code path and Mulliken DFT+U aborts
    #                   with "Method not implemented for k-points". Omitting
    #                   &KPOINTS entirely = Gamma point (the default).
    #   CP2K >= 2026.2: Mulliken DFT+U supports k-points; replace this comment
    #                   with a converged Monkhorst-Pack mesh (e.g.
    #                   &KPOINTS / SCHEME MONKHORST-PACK 4 4 4 / &END KPOINTS).
    # This conventional rocksalt cell is small — pre-2026.2 use a supercell.

    &PRINT
      &PLUS_U ON
      &END PLUS_U
    &END PRINT

  &END DFT

  &SUBSYS
    &CELL
      ABC     4.28 4.28 4.28          # FeO rocksalt conventional cell (Angstrom)
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL

    # AFM-II ordering of rocksalt FeO: ferromagnetic (111) planes with
    # alternating spin direction. Two Fe kinds carry opposite MAGNETIZATION
    # initial guesses; atoms are labeled Fe1/Fe2 accordingly in FeO.xyz.
    &KIND Fe1                             # spin-up Fe sublattice
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
      MAGNETIZATION 4.0                   # Initial guess N_alpha - N_beta;
                                          # Fe2+ d6 high spin ~ +4 mu_B
      &DFT_PLUS_U ON
        L 2
        U_MINUS_J [eV] 4.0            # Fe 3d PBE+Ueff; verify with U scan
      &END DFT_PLUS_U
    &END KIND

    &KIND Fe2                             # spin-down Fe sublattice
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
      MAGNETIZATION -4.0                  # Opposite sign -> AFM starting point
      &DFT_PLUS_U ON
        L 2
        U_MINUS_J [eV] 4.0            # Same Ueff on both sublattices
      &END DFT_PLUS_U
    &END KIND

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./FeO.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

&END FORCE_EVAL

# Post-processing: check output for DFT+U energy contribution and Fe 3d occupations.
