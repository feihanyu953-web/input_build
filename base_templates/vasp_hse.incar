# ==============================================================================
# VASP INCAR | HSE06 Hybrid Functional (Static SCF or Relax)
# ==============================================================================
# WARNING: HSE06 is ~10-100× more expensive than PBE. Use sparingly.
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
SYSTEM   = VASP HSE06 Hybrid          # Human-readable job title
PREC     = Accurate                   # Accurate required for HF exact exchange
ENCUT    = 400                        # Plane-wave cutoff (eV); >= max ENMAX in POTCAR

# ------------------------------------------------------------------------------
# II. ELECTRONIC SCF
# ------------------------------------------------------------------------------
ALGO     = Normal                     # Damped or Normal; avoid Very_Fast for hybrids
EDIFF    = 1E-6                       # Tight SCF convergence
ISMEAR   = 0                          # Gaussian smearing (tetrahedron incompatible with HF)
SIGMA    = 0.05                       # Small smearing for sharp gap edges
NELMIN   = 6                          # Min SCF steps; hybrids converge slowly
NELM     = 100                        # Max SCF steps; increase if convergence stalls

# ------------------------------------------------------------------------------
# III. HYBRID FUNCTIONAL SETTINGS
# ------------------------------------------------------------------------------
LHFCALC  = .TRUE.                     # Enable Hartree-Fock exact exchange
HFSCREEN = 0.2                        # 0.2 = HSE06; 0.0 = PBE0; ∞ = screened HF
PRECFOCK = Fast                       # Fast = reduced FFT grid for Fock; Normal/Accurate = full
                                      # Use Normal for publication-quality, Fast for testing
# AEXX     = 0.25                     # Fraction of exact exchange (default 0.25 = HSE06)
# AGGAX    = 0.75                     # GGA exchange fraction (default 0.75)
# AGGAC    = 1.00                     # GGA correlation fraction (default 1.00)

# Time-saving for large systems (recommended for >50 atoms):
# NKRED    = 2                        # Reduce Fock k-grid by factor 2 in each direction
#                                     # Significant speedup; test convergence vs NKRED=1

# ------------------------------------------------------------------------------
# IV. GEOMETRY (if relaxation needed; comment out for static SCF)
# ------------------------------------------------------------------------------
# IBRION   = 2                        # Conjugate-gradient relax
# ISIF     = 2                        # Relax ions only; fix cell
# NSW      = 50                       # Max ionic steps; hybrid relax is expensive
# EDIFFG   = -0.03                    # Force convergence (eV/A)

# ------------------------------------------------------------------------------
# V. ACCURACY
# ------------------------------------------------------------------------------
ADDGRID  = .TRUE.                     # Finer FFT grid for accurate potential
LASPH    = .TRUE.                     # Non-spherical contributions in PAW

# ------------------------------------------------------------------------------
# VI. PARALLELIZATION (CRITICAL for HSE performance)
# ------------------------------------------------------------------------------
# For hybrids, NPAR must divide NBANDS evenly. Common choices:
# NPAR = 1  (safest, but slow for many cores)
# NPAR = 2, 4 (test for your system)
# NCORE = 1 (required when NPAR > 1 for some VASP versions)
# KPAR = 1  (k-point parallelization limited for hybrids)
#
# NCORE  = 1                          # Often required for NPAR > 1
# NPAR   = 4                          # Tune: must divide NBANDS
# KPAR   = 1                          # Usually 1 for hybrid band structure

# ------------------------------------------------------------------------------
# VII. OUTPUT
# ------------------------------------------------------------------------------
LCHARG   = .TRUE.                     # Save CHGCAR for restart / DOS post-processing
LWAVE    = .TRUE.                     # Save WAVECAR (expensive but needed for restart)

# END OF INCAR

# ==============================================================================
# PERFORMANCE NOTES
# ==============================================================================
# - HSE06 scales as O(N^4) with system size; consider PBE pre-convergence first
# - Hybrid band structures CANNOT use the PBE-style fixed-density trick:
#   "PBE SCF -> HSE06 non-SCF (ICHARG=11) on a k-path" is WRONG for hybrids.
#   The hybrid Hamiltonian depends on the occupied orbitals / Fock operator on the
#   regular k-mesh, not only on the charge density, so ICHARG=11 on a path yields
#   incorrect eigenvalues (vasp.at/wiki/Band-structure_calculation_using_hybrid_functionals).
#   Correct workflows:
#     (a) One hybrid SCF with a KPOINTS file containing the regular k-mesh PLUS
#         zero-weight k-points along the band path (path points get weight 0);
#     (b) KPOINTS_OPT workflow: hybrid SCF on a uniform mesh, then a restart that
#         adds the k-path via a KPOINTS_OPT file (supported in VASP >= 6).
# - PRECFOCK=Fast saves ~30% time with minor accuracy loss; test vs Normal
# - NKRED=2 can save 4-8× time; always verify bandgap converges vs NKRED=1
# ==============================================================================
