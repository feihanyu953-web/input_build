# ==============================================================================
# CP2K Input | H2O Molecule Geometry Optimization (BFGS)
# ==============================================================================

# ------------------------------------------------------------------------------
# I. GLOBAL SETTINGS
# ------------------------------------------------------------------------------
&GLOBAL
  PROJECT     C2_CP2K_H2O_opt         # Job name (prefix for output files)
  RUN_TYPE    GEO_OPT                 # Geometry optimization
  PRINT_LEVEL LOW
&END GLOBAL

# ------------------------------------------------------------------------------
# II. FORCE EVALUATION
# ------------------------------------------------------------------------------
&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME  ./BASIS_MOLOPT
    POTENTIAL_FILE_NAME  ./GTH_POTENTIALS

    &QS
      EPS_DEFAULT 1.0E-12
      METHOD      GPW
    &END QS

    &MGRID
      CUTOFF      400
      REL_CUTOFF  50
      NGRIDS      4
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS   ATOMIC
      EPS_SCF     1.0E-6
      MAX_SCF     300

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD   BROYDEN_MIXING
        ALPHA    0.4
        NBROYDEN 8
      &END MIXING
    &END SCF

    # Isolated molecule (0D): non-periodic Poisson solver.
    # ATOMIC config block: CELL PERIODIC NONE + POISSON PERIODIC NONE
    # + a 0D-compatible solver. The default PERIODIC solver is only valid
    # for fully 3D-periodic systems; ANALYTIC (also: MT, WAVELET) supports 0D.
    # Source: CP2K manual FORCE_EVAL/DFT/POISSON
    &POISSON
      POISSON_SOLVER ANALYTIC
      PERIODIC NONE
    &END POISSON

  &END DFT

  &SUBSYS
    &CELL
      ABC     20.0 20.0 20.0
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC NONE                   # Matches &POISSON PERIODIC NONE above
    &END CELL

    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME    ./H2O.xyz
      COORD_FILE_FORMAT  XYZ
    &END TOPOLOGY
  &END SUBSYS

  # &FORCES belongs to FORCE_EVAL/PRINT — under DFT/PRINT CP2K aborts with
  # "unknown subsection FORCES of section PRINT" (2026.1 runtime-verified).
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT

&END FORCE_EVAL

# ------------------------------------------------------------------------------
# III. GEOMETRY OPTIMIZATION
# ------------------------------------------------------------------------------
&MOTION
  &GEO_OPT
    TYPE         MINIMIZATION
    OPTIMIZER    BFGS
    MAX_ITER     200
    MAX_DR       3.0E-3
    RMS_DR       1.5E-3
    MAX_FORCE    4.5E-4
    RMS_FORCE    3.0E-4
  &END GEO_OPT
&END MOTION

# ==============================================================================
# END OF INPUT
# ==============================================================================
