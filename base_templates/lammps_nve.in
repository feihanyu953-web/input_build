# ==============================================================================
# LAMMPS Input Script | NVE Production (Pre-equilibrated system)
# Generated by input-build
# ==============================================================================
# ASSUMPTION: System has already been equilibrated (temperature / pressure stable).
#             Read a restart file or data file with existing velocities.
# ==============================================================================

# ==============================================================================
# 1. SIMULATION ENVIRONMENT
# ==============================================================================
units           metal               # eV, Å, ps, K, bar
atom_style      atomic              # For MLFF/most potentials (no bond info)
boundary        p p p               # 3D periodic (slab: use p p f, z = surface normal)
newton          on                  # Default; set off for GPU Kokkos if needed

# ==============================================================================
# 2. SYSTEM SETUP
# ==============================================================================
# Option A: Read restart (restores coordinates, velocities and box; fix
# commands must be re-declared in the new input — only the internal state
# of certain fixes is restored. See https://docs.lammps.org/read_restart.html)
# read_restart    equilibrated.restart

# Option B: Read data + create velocities (if restarting from data only)
read_data       system.data
velocity        all create 300.0 12345 dist gaussian
# velocity      all zero linear      # Uncomment to remove COM drift

# ==============================================================================
# 3. FORCE FIELD (User-defined)
# ==============================================================================
# >>> INSERT YOUR POTENTIAL DEFINITION BELOW <<<
#
# Examples:
#
# >>> USER: insert pair_style/pair_coeff here (REQUIRED - examples below) <<<
#
# --- EAM ---
# File format determines pair_style AND pair_coeff arity
# (https://docs.lammps.org/pair_eam.html):
#   funcfl single-element (*.eam, e.g. Cu_u3.eam, Al_u3.eam) -> pair_style eam
#     pair_coeff takes exactly 3 args (* * file) with NO element symbol —
#     pair_eam.cpp enforces narg == 3; a 4th arg (element symbol) aborts with
#     "Incorrect args for pair coefficients" (22Jul2025 runtime-verified)
#   setfl alloy (*.eam.alloy, e.g. Al99.eam.alloy)           -> pair_style eam/alloy
#     pair_coeff REQUIRES element symbol(s) after the file
# A mismatched format/style pair aborts with a potential-file parse error.
# pair_style      eam
# pair_coeff      * * Cu_u3.eam
#
# pair_style      eam/alloy
# pair_coeff      * * Al99.eam.alloy Al
#
# --- DeepMD ---
# pair_style      deepmd graph.pb
# pair_coeff      * *
#
# --- MACE ---
# pair_style      mace
# pair_coeff      * * mace.model H O Pt N Na

# ==============================================================================
# 4. NVE PRODUCTION (No thermostat — energy must be conserved)
# ==============================================================================
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        0.0005              # 0.5 fs (safe for H-containing systems)
# timestep      0.001               # 1.0 fs (for systems without H)

# --- NVE integrator (microcanonical ensemble) ---
fix             prod all nve

# --- Optional: Langevin boundary damping for heat sink (fixed-temperature walls) ---
# Use only if simulating a thermal gradient or thermostatting a subset
# fix             langevin_boundary lower langevin 300.0 300.0 0.05 12345

# --- Output ---
thermo          100
thermo_style    custom step temp press pe ke etotal vol density cpu
#                   ^^^^  ^^^^^  ^^^^
#                   NVE: temp should drift slowly (thermometer, not thermostat)
#                   press fluctuates normally
#                   pe + ke = etotal should be conserved (drift < 1 meV/atom/ps)

# --- Trajectory output ---
dump            1 all custom 100 traj.lammpstrj id type xu yu zu vx vy vz
#               ^                                    ^
#               frequency (steps)                    xu/yu/zu = unwrapped (required for MSD)
dump_modify     1 sort id

# --- Restart files ---
restart         10000 restart1.restart restart2.restart

# --- Run production ---
run             200000              # 100 ps production
# run           2000000             # 1 ns production

# ==============================================================================
# END OF INPUT
# ==============================================================================
# Post-run validation:
# 1. Energy conservation: plot etotal vs step; drift should be < 1 meV/atom/ps
# 2. Temperature drift: expected for NVE; should equilibrate around target T
# 3. If energy drifts upward: reduce timestep or check potential cutoff
# 4. If energy drifts downward: neighbor list issue or potential discontinuity
# ==============================================================================
