# ==============================================================================
# LAMMPS Input Script | PLUMED-enhanced MD (fix plumed)
# Generated by input-build
# ==============================================================================
# PREREQUISITE: LAMMPS must be built with the PLUMED package
# (make yes-plumed; PLUMED 2.x linked). Reference: docs.lammps.org/fix_plumed.html
# RULES (verified against the LAMMPS docs):
# - Only ONE fix plumed may be active at a time.
# - The group-ID of fix plumed is IGNORED: it always applies to group all.
# - fix_modify energy/virial default to yes for this fix (bias is included in
#   the potential energy and pressure).
# - Restarts require the PLUMED-side RESTART keyword inside plumed.dat.
# ==============================================================================

# ==============================================================================
# 1. SIMULATION ENVIRONMENT
# ==============================================================================
units           metal
atom_style      atomic
boundary        p p p
newton          on

# ==============================================================================
# 2. SYSTEM SETUP
# ==============================================================================
read_data       system.data         # >>> USER: your data file <<<

# ==============================================================================
# 3. FORCE FIELD
# ==============================================================================
# >>> USER: insert pair_style/pair_coeff here <<<
# pair_style      eam/alloy
# pair_coeff      * * Al.eam Al

# ==============================================================================
# 4. DYNAMICS + PLUMED
# ==============================================================================
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        0.001               # 1 fs (units metal)

velocity        all create 300.0 12345 dist gaussian
fix             nvt all nvt temp 300.0 300.0 0.1

# --- PLUMED interface (the CVs / bias live in plumed.dat) ---
fix             pl all plumed plumedfile plumed.dat outfile p.log

# ------------------------------------------------------------------------------
# plumed.dat — placeholder sample (DISTANCE CV + PRINT):
#   d1: DISTANCE ATOMS=1,2
#   PRINT ARG=d1 FILE=COLVAR STRIDE=10
# For metadynamics add e.g.:
#   METAD ARG=d1 HEIGHT=1.0 PACE=500 SIGMA=0.1 FILE=HILLS
# On restart, PLUMED needs its own `RESTART` keyword at the top of plumed.dat.
# ------------------------------------------------------------------------------

thermo          100
thermo_style    custom step temp pe etotal vol

dump            1 all custom 1000 traj.lammpstrj id type x y z
dump_modify     1 sort id

# --- Restart files (for crash recovery / continuation) ---
restart         10000 restart1.restart restart2.restart
# To continue: read_restart + re-declare fix plumed + PLUMED-side RESTART keyword

run             100000

# ==============================================================================
# END OF INPUT
# ==============================================================================
